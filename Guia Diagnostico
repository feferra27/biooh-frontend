var sel = null;

(function init(){
  renderList(DISEASES);
})();

function renderList(diseases){
  var list = document.getElementById('diseaseList');
  var html = '';
  for(var i=0; i<diseases.length; i++){
    var d = diseases[i];
    var active = sel && sel.id === d.id ? 'active' : '';
    html += '<div class="ditem '+active+'" onclick="selectDisease(\''+d.id+'\')">'
      + '<div class="dico '+d.color+'">'+d.icon+'</div>'
      + '<div class="dmeta">'
      + '<div class="dname">'+d.name+'</div>'
      + '<div class="dtag">'+d.tag+'</div>'
      + '</div></div>';
  }
  list.innerHTML = html;
}

function filterDiseases(q){
  q = q.toLowerCase().trim();
  if(!q){ renderList(DISEASES); return; }
  var filtered = DISEASES.filter(function(d){
    return d.name.toLowerCase().includes(q) || d.tag.toLowerCase().includes(q);
  });
  renderList(filtered);
}

function selectDisease(id){
  var d = DISEASES.find(function(x){ return x.id === id; });
  if(!d) return;
  sel = d;
  renderList(DISEASES);
  renderContent(d);
  document.getElementById('empty').style.display = 'none';
  document.getElementById('content').style.display = 'block';
}

function renderContent(d){
  var sectionsHtml = '';
  for(var i=0; i<d.sections.length; i++){
    var s = d.sections[i];
    var bulletsHtml = '';
    if(s.bullets){
      bulletsHtml = '<ul>';
      for(var j=0; j<s.bullets.length; j++){
        bulletsHtml += '<li>'+s.bullets[j]+'</li>';
      }
      bulletsHtml += '</ul>';
    }
    var factsHtml = '';
    if(s.facts){
      factsHtml = '<div class="fact-grid">';
      for(var k=0; k<s.facts.length; k++){
        var f = s.facts[k];
        factsHtml += '<div class="fact-item">'
          + '<div class="fact-label">'+f.label+'</div>'
          + '<div class="fact-value">'+f.value+'</div>'
          + '</div>';
      }
      factsHtml += '</div>';
    }
    sectionsHtml += '<div class="card">'
      + '<div class="card-head">'
      + '<div class="card-ico '+s.color+'">'+s.icon+'</div>'
      + '<div class="card-title"><h3>'+s.title+'</h3><p>'+s.subtitle+'</p></div>'
      + '</div>'
      + '<div class="card-body">'
      + (s.text ? '<p>'+s.text+'</p>' : '')
      + bulletsHtml
      + factsHtml
      + '</div>'
      + '</div>';
  }

  var sourcesHtml = '';
  if(d.sources && d.sources.length){
    sourcesHtml = '<div class="sources"><h4>Fontes Cientificas</h4><div class="sources-list">';
    for(var m=0; m<d.sources.length; m++){
      sourcesHtml += '<span class="source-tag">'+d.sources[m]+'</span>';
    }
    sourcesHtml += '</div></div>';
  }

  var content = document.getElementById('content');
  content.innerHTML = '<div class="hero">'
    + '<div class="hero-inner">'
    + '<span class="hero-tag">'+d.hero.tag+'</span>'
    + '<h1 class="hero-title">'+d.hero.title+'</h1>'
    + '<p class="hero-subtitle">'+d.hero.subtitle+'</p>'
    + '</div></div>'
    + '<div class="cards">'+sectionsHtml+sourcesHtml+'</div>';
  content.scrollTop = 0;
}
</script>
