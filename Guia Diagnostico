<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>BiOOH - Guia do Diagnostico</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display&display=swap" rel="stylesheet">
<style>
:root {
  --red:#C8102E; --red-light:#FEE2E2;
  --blue:#1E40AF; --blue-light:#DBEAFE;
  --green:#059669; --green-light:#D1FAE5;
  --orange:#EA580C; --orange-light:#FFEDD5;
  --purple:#7C3AED; --purple-light:#EDE9FE;
  --ink:#0F172A; --sub:#475569; --muted:#94A3B8;
  --border:#E2E8F0; --bg:#F8FAFC; --white:#fff;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{height:100%;overflow:hidden;}
body{font-family:'DM Sans',system-ui,sans-serif;background:var(--bg);color:var(--ink);}

/* HEADER */
.hdr{height:64px;display:flex;align-items:center;justify-content:space-between;padding:0 24px;background:#fff;border-bottom:1px solid var(--border);flex-shrink:0;}
.hdr-l{display:flex;align-items:center;gap:14px;}
.hdr-brand{display:flex;align-items:center;gap:10px;}
.hdr-mark{width:32px;height:32px;border-radius:8px;background:var(--red);}
.hdr-name{font-weight:700;font-size:17px;}
.hdr-sep{width:1px;height:22px;background:var(--border);}
.hdr-title{font-size:14px;color:var(--sub);font-weight:500;}
.back-btn{display:flex;align-items:center;gap:6px;border:1px solid var(--border);background:#fff;padding:8px 16px;border-radius:8px;font:600 13px 'DM Sans',sans-serif;color:var(--sub);cursor:pointer;transition:all .15s;text-decoration:none;}
.back-btn:hover{background:var(--bg);color:var(--ink);}

/* LAYOUT */
.layout{display:flex;height:calc(100% - 64px);overflow:hidden;}

/* SIDEBAR */
.sidebar{width:320px;background:#fff;border-right:1px solid var(--border);display:flex;flex-direction:column;overflow:hidden;flex-shrink:0;}
.sidebar-top{padding:18px 20px 14px;border-bottom:1px solid var(--border);}
.sidebar-top h2{font-family:'DM Serif Display',serif;font-size:22px;font-weight:400;margin-bottom:4px;}
.sidebar-top p{font-size:13px;color:var(--sub);}
.search{position:relative;margin-top:14px;}
.search-ico{position:absolute;left:12px;top:50%;transform:translateY(-50%);font-size:14px;color:var(--muted);pointer-events:none;}
.search input{width:100%;padding:9px 12px 9px 34px;border:1px solid var(--border);border-radius:8px;font:400 13px 'DM Sans',sans-serif;background:var(--bg);outline:none;transition:border-color .15s;}
.search input:focus{border-color:#93C5FD;background:#fff;}
.disease-list{flex:1;overflow-y:auto;padding:12px 16px;}
.disease-list::-webkit-scrollbar{width:4px;}
.disease-list::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px;}

/* DISEASE ITEM */
.ditem{border:1px solid var(--border);border-radius:10px;padding:12px 14px;margin-bottom:8px;background:#fff;cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:12px;}
.ditem:hover{border-color:#CBD5E1;box-shadow:0 2px 10px rgba(0,0,0,.06);}
.ditem.active{border-color:var(--red);background:var(--red-light);}
.dico{width:44px;height:44px;border-radius:9px;display:flex;align-items:center;justify-content:center;font-size:22px;flex-shrink:0;}
.dmeta{flex:1;min-width:0;}
.dname{font-size:14px;font-weight:600;margin-bottom:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
.ditem.active .dname{color:var(--red);}
.dtag{font-size:11px;color:var(--muted);font-weight:500;}

/* MAIN */
.main{flex:1;display:flex;flex-direction:column;overflow:hidden;background:#fff;}
.empty{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;color:var(--muted);}
.empty-ico{font-size:56px;opacity:.3;}
.empty-txt{font-size:15px;font-weight:500;}

/* CONTENT */
.content{flex:1;overflow-y:auto;}
.content::-webkit-scrollbar{width:4px;}
.content::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px;}

/* HERO */
.hero{background:linear-gradient(135deg,#1E40AF 0%,#7C3AED 100%);padding:48px 40px;color:#fff;position:relative;overflow:hidden;}
.hero::before{content:'';position:absolute;inset:0;background:url('data:image/svg+xml,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><circle cx="50" cy="50" r="40" fill="white" opacity="0.03"/></svg>');opacity:.15;}
.hero-inner{position:relative;z-index:1;max-width:720px;}
.hero-tag{display:inline-block;padding:5px 12px;border-radius:999px;background:rgba(255,255,255,.2);font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.8px;margin-bottom:14px;}
.hero-title{font-family:'DM Serif Display',serif;font-size:38px;font-weight:400;line-height:1.2;margin-bottom:14px;}
.hero-subtitle{font-size:17px;line-height:1.6;opacity:.95;}

/* CARDS */
.cards{padding:32px 40px;}
.card{background:#fff;border:1px solid var(--border);border-radius:14px;padding:28px;margin-bottom:24px;transition:all .2s;}
.card:hover{box-shadow:0 4px 20px rgba(0,0,0,.08);}
.card-head{display:flex;align-items:flex-start;gap:16px;margin-bottom:20px;}
.card-ico{width:56px;height:56px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:28px;flex-shrink:0;}
.card-title{flex:1;}
.card-title h3{font-family:'DM Serif Display',serif;font-size:24px;font-weight:400;margin-bottom:4px;}
.card-title p{font-size:14px;color:var(--sub);}
.card-body{}
.card-body p{font-size:15px;line-height:1.7;color:var(--sub);margin-bottom:16px;}
.card-body ul{list-style:none;padding:0;}
.card-body ul li{font-size:15px;color:var(--sub);line-height:1.6;padding:7px 0 7px 24px;position:relative;}
.card-body ul li::before{content:'✓';position:absolute;left:0;color:var(--green);font-weight:700;font-size:16px;}
.fact-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:14px;margin-top:14px;}
.fact-item{background:var(--bg);border:1px solid var(--border);border-radius:10px;padding:16px;}
.fact-label{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.7px;color:var(--muted);margin-bottom:6px;}
.fact-value{font-size:18px;font-weight:700;color:var(--ink);line-height:1.3;}

/* SOURCES */
.sources{background:var(--bg);border:1px solid var(--border);border-radius:12px;padding:20px 24px;margin-top:24px;}
.sources h4{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.8px;color:var(--sub);margin-bottom:12px;}
.sources-list{display:flex;flex-wrap:wrap;gap:8px;}
.source-tag{display:inline-flex;align-items:center;gap:6px;padding:6px 12px;border-radius:999px;background:#fff;border:1px solid var(--border);font-size:12px;font-weight:600;color:var(--sub);transition:all .15s;}
.source-tag:hover{border-color:var(--blue);color:var(--blue);box-shadow:0 2px 8px rgba(30,64,175,.15);}
.source-tag::before{content:'📚';font-size:14px;}

/* COLORS */
.blue{background:var(--blue-light);color:var(--blue);border-color:var(--blue);}
.green{background:var(--green-light);color:var(--green);border-color:var(--green);}
.orange{background:var(--orange-light);color:var(--orange);border-color:var(--orange);}
.purple{background:var(--purple-light);color:var(--purple);border-color:var(--purple);}
.red{background:var(--red-light);color:var(--red);border-color:var(--red);}
</style>
</head>
<body>

<div class="hdr">
  <div class="hdr-l">
    <a class="back-btn" href="index.html">← Voltar</a>
    <div class="hdr-brand"><div class="hdr-mark"></div><span class="hdr-name">BiOOH</span></div>
    <div class="hdr-sep"></div>
    <span class="hdr-title">Guia do Diagnostico</span>
  </div>
</div>

<div class="layout">

  <!-- SIDEBAR -->
  <div class="sidebar">
    <div class="sidebar-top">
